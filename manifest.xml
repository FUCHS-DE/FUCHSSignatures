<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <!-- Eindeutige GUID – bei Produktion mit neuem GUID ersetzen -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>FUCHS</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="FUCHS Signatur"/>
  <Description DefaultValue="Zentralisierte Signaturen je Absender und Mandant"/>

  <!-- Icons: Pfade anpassen nach Deployment -->
  <IconUrl DefaultValue="https://YOUR_HOST/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR_HOST/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://YOUR_HOST"/>

  <AppDomains>
    <AppDomain>https://YOUR_HOST</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
    <!-- SharePoint-Domain eintragen, z.B.: -->
    <!-- <AppDomain>https://fuchs-ag.sharepoint.com</AppDomain> -->
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <!-- Mailbox 1.10 = Mindestanforderung für setSignatureAsync -->
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>

  <!-- Pflichtfeld, wird durch VersionOverrides überschrieben -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_HOST/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <!-- VersionOverrides: Event-based Activation -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets>
          <bt:Set Name="Mailbox" MinVersion="1.10"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>

            <!-- Die HTML-Datei, die das JS lädt -->
            <FunctionFile resid="Commands.Url"/>

            <!-- Event-based Activation:
                 Feuert automatisch ohne Nutzerinteraktion -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <!-- Neue Mail -->
                <LaunchEvent Type="OnNewMessageCompose"  FunctionName="handleSignature"/>
                <!-- Absender wird geändert → Signatur sofort tauschen -->
                <LaunchEvent Type="OnMessageFromChanged" FunctionName="handleSignature"/>
                <!-- Antwort / Weiterleitung -->
                <LaunchEvent Type="OnNewMessageReply"    FunctionName="handleSignature"/>
                <LaunchEvent Type="OnMessageReplyAll"    FunctionName="handleSignature"/>
                <LaunchEvent Type="OnMessageForward"     FunctionName="handleSignature"/>
              </LaunchEvents>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://YOUR_HOST/commands.html"/>
        </bt:Urls>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
